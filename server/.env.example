# Copy this file to a new file named ".env" (same folder) and fill in your values.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password-here
DB_NAME=aria_store
JWT_SECRET=change-this-to-a-long-random-text
CLIENT_URL=http://localhost:5173
# Used once by "npm run setup-db" to create the first admin account
ADMIN_EMAIL=admin@aria.test
ADMIN_PASSWORD=admin12345

# ONLY when you put the shop online: paste the connection string from your hosted database here
# (Neon / Supabase / Render). When this line is set, the DB_* lines above are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname
